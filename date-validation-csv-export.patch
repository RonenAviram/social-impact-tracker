From feda03d1a232c63c01a84f6ed0a7dcca2d299be8 Mon Sep 17 00:00:00 2001
From: Ronen Aviram <ronen@example.com>
Date: Wed, 16 Sep 2026 06:35:41 +0000
Subject: [PATCH] Add campaign start date validation + improve CSV export

- form.html: set min date on upload/update inputs to campaign start_date
- form.html: validate dates in validateCurrentStep() and saveUpdate()
- dashboard.html: export all dynamic metrics per platform (not hardcoded)
- dashboard.html: add CSV escaping, campaign name in filename, empty check
---
 dashboard.html | 31 +++++++++++++++++++++++++++----
 form.html      | 22 ++++++++++++++++++++++
 2 files changed, 49 insertions(+), 4 deletions(-)

diff --git a/dashboard.html b/dashboard.html
index 3594e09..cd15203 100644
--- a/dashboard.html
+++ b/dashboard.html
@@ -1420,14 +1420,37 @@ function showEndDateWarning(campData) {
 
 function exportCSV() {
   const d = filtered();
-  let csv = 'תאריך,שם,ארגון,פלטפורמה,סוג,חשיפות,לייקים,תגובות,שיתופים,קישור\n';
+  if (!d.length) { showToast('אין נתונים לייצוא'); return; }
+
+  // Collect all unique metric keys across all entries
+  const allMetricKeys = new Set();
+  d.forEach(e => Object.keys(e.metrics).forEach(k => allMetricKeys.add(k)));
+  const metricKeys = [...allMetricKeys].sort();
+
+  // Build metric labels from CONFIG
+  const metricLabels = {};
+  CONFIG.PLATFORMS.forEach(p => p.metrics.forEach(m => { metricLabels[m.id] = m.label; }));
+
+  function csvEscape(val) {
+    const s = String(val == null ? '' : val);
+    return s.includes(',') || s.includes('"') || s.includes('\n') ? '"' + s.replace(/"/g, '""') + '"' : s;
+  }
+
+  const headers = ['תאריך', 'שם', 'ארגון', 'פלטפורמה', 'סוג', 'חשיפות', 'מעורבות',
+    ...metricKeys.map(k => metricLabels[k] || k), 'קישור'];
+  let csv = headers.map(csvEscape).join(',') + '\n';
+
   d.forEach(e => {
-    csv += `${e.date},${e.person.name},${e.person.orgDisplay},${e.platformName},${e.type},${e.reach},${e.metrics.likes||0},${e.metrics.comments||0},${e.metrics.shares||0},${e.link||''}\n`;
+    const row = [e.date, e.person.name, e.person.orgDisplay, e.platformName, e.type, e.reach, e.engagement,
+      ...metricKeys.map(k => e.metrics[k] || 0), e.link || ''];
+    csv += row.map(csvEscape).join(',') + '\n';
   });
-  const blob = new Blob(['﻿' + csv], {type:'text/csv;charset=utf-8'});
+
+  const blob = new Blob(['\uFEFF' + csv], {type:'text/csv;charset=utf-8'});
   const a = document.createElement('a');
   a.href = URL.createObjectURL(blob);
-  a.download = 'נתוני_קמפיין.csv';
+  const campName = document.getElementById('campaignDropdownBtn')?.textContent?.trim() || 'קמפיין';
+  a.download = `${campName}_${new Date().toISOString().slice(0,10)}.csv`;
   a.click();
   showToast('הקובץ הורד');
 }
diff --git a/form.html b/form.html
index a18d8d0..7594a8f 100644
--- a/form.html
+++ b/form.html
@@ -455,6 +455,11 @@ async function init() {
     }
 
     document.getElementById('uploadDate').value = today();
+    // Restrict date inputs to campaign start date
+    if (CAMPAIGN.start_date) {
+      document.getElementById('uploadDate').min = CAMPAIGN.start_date;
+      document.getElementById('updateDate').min = CAMPAIGN.start_date;
+    }
 
     // Build upload platform grid
     const grid = document.getElementById('uploadPlatformGrid');
@@ -985,6 +990,17 @@ function validateCurrentStep() {
   const plat = uploadSelectedPlatforms[currentPlatformIdx];
   const isNewspaper = plat && plat.id === 'newspaper';
 
+  // Validate date is not before campaign start
+  const dateInput = document.getElementById('uploadDate');
+  if (date && CAMPAIGN.start_date && date < CAMPAIGN.start_date) {
+    dateInput.style.borderColor = 'var(--red-400)';
+    document.getElementById('btnNextPlatform').disabled = true;
+    showToast('לא ניתן להזין תאריך לפני תחילת הקמפיין (' + formatDate(CAMPAIGN.start_date) + ')');
+    return;
+  } else if (date) {
+    dateInput.style.borderColor = '';
+  }
+
   if (link && !isValidUrl(link)) {
     linkInput.style.borderColor = 'var(--red-400)';
     hint.textContent = 'הקישור חייב להתחיל ב-https:// או http://';
@@ -1146,6 +1162,12 @@ function showUpdateScreen(contentId) {
 async function saveUpdate() {
   if (!editingContentId || !currentUser) return;
 
+  const updateDateVal = document.getElementById('updateDate').value;
+  if (updateDateVal && CAMPAIGN.start_date && updateDateVal < CAMPAIGN.start_date) {
+    showToast('לא ניתן להזין תאריך לפני תחילת הקמפיין (' + formatDate(CAMPAIGN.start_date) + ')');
+    return;
+  }
+
   const metricInputs = document.querySelectorAll('#updateMetrics input[data-metric]');
   let allFilled = true;
   metricInputs.forEach(inp => { if (inp.value === '' || inp.value === null) allFilled = false; });
-- 
